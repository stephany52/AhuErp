<UserControl x:Class="AhuErp.UI.Views.MyDesktopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AhuErp.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MyDesktopViewModel}"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding Greeting}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="  Непрочитано: " Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding UnreadCount}" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="Отметить всё прочитанным" Command="{Binding MarkAllReadCommand}"
                    Padding="10,4" Margin="16,0,0,0" />
            <Button Content="Обновить" Command="{Binding ReloadCommand}" Padding="10,4" Margin="8,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1"
                Padding="12,8" CornerRadius="4" Margin="0,12,0,8"
                Visibility="{Binding SubstitutionBanner, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding SubstitutionBanner}" Foreground="#664D03" />
        </Border>

        <TabControl Grid.Row="2" Grid.Column="0" Margin="0,8,12,0">
            <TabItem Header="Назначены мне">
                <DataGrid ItemsSource="{Binding Tasks}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="Документ" Binding="{Binding Document.Title}" Width="*" />
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" />
                        <DataGridTextColumn Header="Срок" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource EnumDisplayConverter}}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="На согласовании у меня">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ApprovalStatuses}"
                                  SelectedItem="{Binding SelectedApprovalStatus}"
                                  ItemTemplate="{StaticResource EnumComboBoxItemTemplate}"
                                  MinWidth="150" Padding="6" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Approvals}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Документ" Binding="{Binding Document.Title}" Width="*" />
                            <DataGridTextColumn Header="Этап" Binding="{Binding Order}" Width="60" />
                            <DataGridTextColumn Header="Решение" Binding="{Binding Decision, Converter={StaticResource EnumDisplayConverter}}" Width="120" />
                            <DataGridTextColumn Header="Дата решения" Binding="{Binding DecisionDate, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Резолюции от меня">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="#F9FAFB" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding DisciplineSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding DisciplineRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      MaxHeight="130"
                                      Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Исполнитель" Binding="{Binding ExecutorName}" Width="*" />
                                    <DataGridTextColumn Header="Всего" Binding="{Binding Total}" Width="70" />
                                    <DataGridTextColumn Header="В срок" Binding="{Binding CompletedOnTime}" Width="70" />
                                    <DataGridTextColumn Header="После срока" Binding="{Binding CompletedLate}" Width="90" />
                                    <DataGridTextColumn Header="Просрочка" Binding="{Binding Overdue}" Width="90" />
                                    <DataGridTextColumn Header="% исполнения" Binding="{Binding TimelyExecutionRate, StringFormat=P0}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Resolutions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding IssuedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                            <DataGridTextColumn Header="Документ" Binding="{Binding Document.Title}" Width="*" />
                            <DataGridTextColumn Header="Резолюция" Binding="{Binding Text}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Grid.Column="1" Background="White" CornerRadius="4" Padding="8" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Уведомления" FontWeight="SemiBold" Margin="4,4,4,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                        Padding="6,8" Margin="0,0,0,4"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="#333" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Foreground="Gray" FontSize="11" />
                                            <Button Content="Прочитано"
                                                    Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
