<UserControl x:Class="AhuErp.UI.Views.RkkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AhuErp.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RkkViewModel}"
             d:DesignHeight="720" d:DesignWidth="1200">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Регистрационно-контрольная карточка"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,8" TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Новый" Command="{Binding NewCommand}" MinWidth="70" Padding="6,3" Margin="0,0,6,0" />
                <Button Content="Обновить" Command="{Binding ReloadCommand}" MinWidth="80" Padding="6,3" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding RegistrationNumber}" Width="120" />
                    <DataGridTextColumn Header="Тема" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Создан" Binding="{Binding CreationDate, StringFormat=dd.MM.yy}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="4" Padding="12">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1"
                        CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" MinWidth="100" Padding="8,4" Margin="0,0,6,0" />
                    <Button Content="Зарегистрировать"
                            Command="{Binding RegisterCommand}"
                            ToolTip="Регистрационный номер формируется по шаблону вида документа: {Код}-{ДелоМ.Г.}/{Год}-{Порядковый}. Если документ не привязан к делу номенклатуры, в поле дела появится «Б/Н»."
                            MinWidth="140" Padding="8,4" />
                </StackPanel>

                <TabControl>
                    <TabItem Header="1. Реквизиты">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Регистрационный номер" Margin="0,4" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,4">
                                    <TextBlock Text="{Binding RegistrationNumberDisplay}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="#FCD34D" Padding="6,1" CornerRadius="3" Margin="12,0,0,0"
                                            Visibility="{Binding SelectedDocument.IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="Документ закрыт квалифицированной подписью и доступен только для чтения">
                                        <TextBlock Text="🔒 Документ заблокирован КЭП" FontWeight="SemiBold" Foreground="#78350F" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Дата регистрации" Margin="0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SelectedDocument.RegistrationDate, StringFormat=dd.MM.yyyy HH:mm, FallbackValue=''}"
                                           Margin="6,4" />

                                <TextBlock Grid.Row="2" Text="Вид документа" Margin="0,4" />
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          ItemsSource="{Binding DocumentTypes}"
                                          SelectedItem="{Binding SelectedType}"
                                          DisplayMemberPath="Name"
                                          Margin="6,4" Padding="6" />

                                <TextBlock Grid.Row="3" Text="Дело (номенклатура)" Margin="0,4" />
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          ItemsSource="{Binding NomenclatureCases}"
                                          SelectedItem="{Binding SelectedCase}"
                                          Margin="6,4" Padding="6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Index}" FontWeight="SemiBold" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding Title}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="4" Text="Направление" Margin="0,4" />
                                <ComboBox Grid.Row="4" Grid.Column="1"
                                          ItemsSource="{Binding Directions}"
                                          SelectedItem="{Binding SelectedDirection}"
                                          ItemTemplate="{StaticResource EnumComboBoxItemTemplate}"
                                          Margin="6,4" Padding="6" />

                                <TextBlock Grid.Row="5" Text="Гриф доступа" Margin="0,4" />
                                <ComboBox Grid.Row="5" Grid.Column="1"
                                          ItemsSource="{Binding AccessLevels}"
                                          SelectedItem="{Binding SelectedAccessLevel}"
                                          ItemTemplate="{StaticResource EnumComboBoxItemTemplate}"
                                          Margin="6,4" Padding="6" />

                                <TextBlock Grid.Row="6" Text="Заголовок" Margin="0,4" />
                                <TextBox Grid.Row="6" Grid.Column="1"
                                         Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding SelectedDocument.IsLocked, FallbackValue=False}"
                                         Margin="6,4" Padding="6" />

                                <TextBlock Grid.Row="7" Text="Корреспондент" Margin="0,4" />
                                <TextBox Grid.Row="7" Grid.Column="1"
                                         Text="{Binding DraftCorrespondent, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding SelectedDocument.IsLocked, FallbackValue=False}"
                                         Margin="6,4" Padding="6" />

                                <TextBlock Grid.Row="8" Text="Срок исполнения" Margin="0,4" />
                                <DatePicker Grid.Row="8" Grid.Column="1"
                                            SelectedDate="{Binding DraftDeadline, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="6,4" />

                                <TextBlock Grid.Row="9" Text="Краткое содержание" Margin="0,4" />
                                <TextBox Grid.Row="9" Grid.Column="1"
                                         Text="{Binding DraftSummary, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding SelectedDocument.IsLocked, FallbackValue=False}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="80" Margin="6,4" Padding="6"
                                         VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="2. Вложения">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Загрузить файл"
                                        Command="{Binding AddAttachmentCommand}"
                                        Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="Новая версия выбранного"
                                        Command="{Binding AddAttachmentVersionCommand}"
                                        Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="Открыть"
                                        Command="{Binding OpenAttachmentCommand}"
                                        Padding="8,4" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Файлы документа с историей версий. Выберите версию и нажмите соответствующую кнопку."
                                       Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding Attachments}"
                                      SelectedItem="{Binding SelectedAttachment, UpdateSourceTrigger=PropertyChanged}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Версия" Binding="{Binding VersionNumber}" Width="60" />
                                    <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTextColumn Header="Тип" Binding="{Binding FileType, Converter={StaticResource EnumDisplayConverter}}" Width="100" />
                                    <DataGridTextColumn Header="Загружено" Binding="{Binding UploadedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                                    <DataGridCheckBoxColumn Header="Текущая" Binding="{Binding IsCurrentVersion}" Width="80" />
                                    <DataGridTextColumn Header="Размер, байт" Binding="{Binding SizeBytes}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="3. Поручения и контроль">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <!-- Bug #4: верхняя секция «Резолюции руководителя»
                                     отделена от секции «Поручения по документу».
                                     Резолюция — текстовое указание автора (с упоминанием
                                     исполнителя «@ФамилияИО»); поручение — формализованная
                                     задача с дедлайном. -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="160" />
                            </Grid.RowDefinitions>

                            <!-- Резолюции руководителя -->
                            <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="Резолюции руководителя"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewResolutionText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,6,0" Padding="6"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="48"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Текст резолюции. Упомяните исполнителя как @ФамилияИО — он получит уведомление." />
                                        <Button Grid.Column="1"
                                                Content="Наложить резолюцию"
                                                Command="{Binding AddResolutionCommand}"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                ToolTip="Доступно руководителю и администратору" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Resolutions}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding IssuedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                                    <DataGridTextColumn Header="Автор" Binding="{Binding Author.FullName, FallbackValue=''}" Width="180" />
                                    <DataGridTextColumn Header="Текст резолюции" Binding="{Binding Text}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Поручения по документу -->
                            <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="Поручения по документу"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,6,0" Padding="6"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Описание поручения" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Employees}"
                                                  SelectedItem="{Binding NewTaskExecutor}"
                                                  DisplayMemberPath="FullName"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"
                                                  TextSearch.TextPath="FullName"
                                                  ToolTip="Исполнитель — начните вводить ФИО"
                                                  Margin="0,0,6,0" Padding="6"
                                                  VerticalAlignment="Center" />
                                        <DatePicker Grid.Column="2"
                                                    SelectedDate="{Binding NewTaskDeadline}"
                                                    Margin="0,0,6,0" />
                                        <Button Grid.Column="3"
                                                Content="Создать поручение"
                                                Command="{Binding AddTaskCommand}"
                                                Padding="8,4" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <DockPanel Grid.Row="3">
                                <Border DockPanel.Dock="Bottom" Background="#F9FAFB" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Отметить выполненным"
                                                Command="{Binding CompleteTaskCommand}"
                                                Padding="8,4" Margin="0,0,6,0" />
                                        <Button Content="Отменить поручение"
                                                Command="{Binding CancelTaskCommand}"
                                                Padding="8,4" Margin="0,0,18,0" />
                                        <TextBlock Text="Переназначить:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding Employees}"
                                                  SelectedItem="{Binding ReassignTaskExecutor}"
                                                  DisplayMemberPath="FullName"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="FullName"
                                                  MinWidth="200" Padding="6" Margin="0,0,6,0" />
                                        <Button Content="Переназначить"
                                                Command="{Binding ReassignTaskCommand}"
                                                Padding="8,4" />
                                    </StackPanel>
                                </Border>
                                <DataGrid ItemsSource="{Binding Tasks}"
                                          SelectedItem="{Binding SelectedTask, UpdateSourceTrigger=PropertyChanged}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40" />
                                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                                        <DataGridTextColumn Header="Исполнитель" Binding="{Binding Executor.FullName, FallbackValue=''}" Width="160" />
                                        <DataGridTextColumn Header="Срок" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy}" Width="100" />
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource EnumDisplayConverter}}" Width="120" />
                                        <DataGridTextColumn Header="Завершено" Binding="{Binding CompletedAt, StringFormat=dd.MM.yyyy}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="4. Согласование и маршрут">
                        <DockPanel Margin="12">
                            <Border DockPanel.Dock="Top" Background="#F9FAFB" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Шаблон маршрута:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding RouteTemplates}"
                                              SelectedItem="{Binding SelectedRouteTemplate}"
                                              DisplayMemberPath="Name"
                                              MinWidth="240" Padding="6" Margin="0,0,6,0" />
                                    <Button Content="Запустить согласование"
                                            Command="{Binding StartApprovalRouteCommand}"
                                            Padding="8,4" />
                                </StackPanel>
                            </Border>
                            <Border DockPanel.Dock="Bottom" Background="#F9FAFB" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Решение по выбранному этапу (доступно только согласующему данного этапа):"
                                               Foreground="#6B7280" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding ApprovalComment, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Комментарий к решению (опционально)"
                                                 MinWidth="320" Padding="6" Margin="0,0,6,0" />
                                        <Button Content="Согласовать" Command="{Binding ApproveCommand}" Padding="8,4" Margin="0,0,6,0" />
                                        <Button Content="Отклонить"   Command="{Binding RejectCommand}"  Padding="8,4" Margin="0,0,6,0" />
                                        <Button Content="Замечания"   Command="{Binding CommentApprovalCommand}" Padding="8,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Этапы маршрута согласования. Решения по каждому этапу формируют итоговый статус документа."
                                       Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding Approvals}"
                                      SelectedItem="{Binding SelectedApproval, UpdateSourceTrigger=PropertyChanged}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Этап" Binding="{Binding Order}" Width="60" />
                                    <DataGridTextColumn Header="Согласующий" Binding="{Binding Approver.FullName, FallbackValue=''}" Width="180" />
                                    <DataGridTextColumn Header="Параллельно" Binding="{Binding IsParallel, Converter={StaticResource BooleanDisplayConverter}}" Width="100" />
                                    <DataGridTextColumn Header="Решение" Binding="{Binding Decision, Converter={StaticResource EnumDisplayConverter}}" Width="120" />
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DecisionDate, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="5. Связанные документы и АХД">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                            <StackPanel>
                                <TextBlock Text="Создать связанную операцию"
                                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                                <Border Padding="10" Margin="0,0,0,8"
                                        Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="Акт списания ТМЦ" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Позиция:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <ComboBox ItemsSource="{Binding InventoryItems}"
                                                      SelectedItem="{Binding NewWriteOffItem}"
                                                      DisplayMemberPath="Name"
                                                      MinWidth="220" Padding="6" Margin="0,0,12,0" />
                                            <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Text="{Binding NewWriteOffQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="80" Padding="6" Margin="0,0,12,0" />
                                            <Button Content="Создать списание"
                                                    Command="{Binding CreateInventoryWriteOffCommand}"
                                                    Padding="10,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Padding="10" Margin="0,0,0,8"
                                        Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="Путевой лист" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="ТС:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <ComboBox ItemsSource="{Binding Vehicles}"
                                                      SelectedItem="{Binding NewTripVehicle}"
                                                      DisplayMemberPath="LicensePlate"
                                                      MinWidth="160" Padding="6" Margin="0,0,12,0" />
                                            <TextBlock Text="Водитель:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Text="{Binding NewTripDriver, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="200" Padding="6" Margin="0,0,12,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <DatePicker SelectedDate="{Binding NewTripStart}" Width="120" Margin="0,0,12,0" />
                                            <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <DatePicker SelectedDate="{Binding NewTripEnd}" Width="120" Margin="0,0,12,0" />
                                            <Button Content="Создать путевой лист"
                                                    Command="{Binding CreateVehicleTripCommand}"
                                                    Padding="10,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Padding="10" Margin="0,0,0,8"
                                        Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Создать заявку в архив"
                                                Command="{Binding CreateArchiveRequestCommand}"
                                                Padding="10,4" Margin="0,0,8,0" />
                                        <Button Content="Создать IT-тикет"
                                                Command="{Binding CreateItTicketCommand}"
                                                Padding="10,4" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Существующие связи"
                                           FontWeight="SemiBold" FontSize="14" Margin="0,12,0,8" />

                                <TextBlock Text="Списания ТМЦ" Margin="0,0,0,4" />
                                <DataGrid ItemsSource="{Binding RelatedInventoryTx}"
                                          SelectedItem="{Binding SelectedInventoryTx, UpdateSourceTrigger=PropertyChanged}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="160" Margin="0,0,0,4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Дата"
                                                            Binding="{Binding TransactionDate, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                                        <DataGridTextColumn Header="Позиция"
                                                            Binding="{Binding InventoryItem.Name}" Width="*" />
                                        <DataGridTextColumn Header="Изменение"
                                                            Binding="{Binding QuantityChanged}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Отменить выбранное списание (компенсирующая транзакция)"
                                        Command="{Binding CancelInventoryWriteOffCommand}"
                                        HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,8" />

                                <TextBlock Text="Путевые листы" Margin="0,0,0,4" />
                                <DataGrid ItemsSource="{Binding RelatedTrips}"
                                          SelectedItem="{Binding SelectedTrip, UpdateSourceTrigger=PropertyChanged}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="С"
                                                            Binding="{Binding StartDate, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                                        <DataGridTextColumn Header="По"
                                                            Binding="{Binding EndDate, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                                        <DataGridTextColumn Header="ТС"
                                                            Binding="{Binding Vehicle.LicensePlate}" Width="120" />
                                        <DataGridTextColumn Header="Водитель"
                                                            Binding="{Binding DriverName}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Отменить выбранный путевой лист"
                                        Command="{Binding CancelVehicleTripCommand}"
                                        HorizontalAlignment="Left" Padding="8,4" Margin="0,4,0,0" />

                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="6. Подписи">
                        <DockPanel Margin="8">
                            <Border DockPanel.Dock="Top" Background="#FEF3C7" BorderBrush="#F59E0B"
                                    BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,6"
                                    Visibility="{Binding SelectedDocument.IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="🔒 Документ заблокирован квалифицированной подписью. Можно менять только статус, исполнителя и гриф доступа."
                                           Foreground="#92400E" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Подписать ПЭП" Command="{Binding SignSimpleCommand}"
                                        MinWidth="130" Padding="6,3" Margin="0,0,6,0" />
                                <Button Content="Подписать КЭП" Command="{Binding SignQualifiedCommand}"
                                        MinWidth="130" Padding="6,3" Margin="0,0,6,0" />
                                <Button Content="Отозвать" Command="{Binding RevokeSignatureCommand}"
                                        MinWidth="100" Padding="6,3" Margin="0,0,12,0" />
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Основание:" Grid.Row="0" Grid.Column="0" Margin="0,4,8,4" />
                                <TextBox Text="{Binding SignReason, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="0" Grid.Column="1" Margin="0,2" />
                                <TextBlock Text="Thumbprint (КЭП):" Grid.Row="1" Grid.Column="0" Margin="0,4,8,4" />
                                <TextBox Text="{Binding SignCertificateThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="1" Grid.Column="1" Margin="0,2"
                                         ToolTip="Отпечаток сертификата КЭП в CryptoPro CSP" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding Signatures}"
                                      SelectedItem="{Binding SelectedSignature, UpdateSourceTrigger=PropertyChanged}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Подписан" Binding="{Binding SignedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                                    <DataGridTextColumn Header="Подписант" Binding="{Binding Signer.FullName}" Width="*" />
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Kind, Converter={StaticResource EnumDisplayConverter}}" Width="160" />
                                    <DataGridTextColumn Header="Сертификат" Binding="{Binding CertificateSubject}" Width="240" />
                                    <DataGridTextColumn Header="Основание" Binding="{Binding Reason}" Width="200" />
                                    <DataGridCheckBoxColumn Header="Отозвано" Binding="{Binding IsRevoked}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="7. История и аудит">
                        <DockPanel Margin="12">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Хронология действий по документу. Цепочка hash-целостности проверяется в журнале аудита."
                                       Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding History}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="160" />
                                    <DataGridTextColumn Header="Действие" Binding="{Binding ActionType, Converter={StaticResource EnumDisplayConverter}}" Width="160" />
                                    <DataGridTextColumn Header="Пользователь" Binding="{Binding UserId}" Width="100" />
                                    <DataGridTextColumn Header="Изменения" Binding="{Binding NewValues, Converter={StaticResource AuditValuesConverter}}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
