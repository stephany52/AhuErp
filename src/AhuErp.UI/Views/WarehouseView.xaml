<UserControl x:Class="AhuErp.UI.Views.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AhuErp.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WarehouseViewModel}"
             d:DesignHeight="560" d:DesignWidth="1000">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Склад / ТМЦ"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40" />
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category, Converter={StaticResource EnumDisplayConverter}}" Width="140" />
                    <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="70" />
                    <DataGridTextColumn Header="Мин." Binding="{Binding MinimumBalance}" Width="70" />
                    <DataGridTextColumn Header="Остаток" Binding="{Binding TotalQuantity}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="Операция" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                    <Expander Header="Добавить позицию" IsExpanded="False" Margin="0,0,0,12">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Наименование" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                            <TextBlock Text="Категория" Margin="0,8,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding NewItemCategory}"
                                      ItemTemplate="{StaticResource EnumComboBoxItemTemplate}"
                                      Padding="6" />
                            <TextBlock Text="Ед. измерения" Margin="0,8,0,4" />
                            <TextBox Text="{Binding NewItemUnit, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                            <TextBlock Text="Мин. остаток" Margin="0,8,0,4" />
                            <TextBox Text="{Binding NewItemMinimumBalance, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                            <Button Content="Добавить позицию" Command="{Binding AddItemCommand}" Padding="8,6" Margin="0,10,0,0" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="Позиция" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Items}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                              Padding="6" />

                    <TextBlock Text="Количество" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6" />

                    <TextBlock Text="Документ-основание" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding EligibleDocuments}"
                              SelectedItem="{Binding SelectedDocument, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Title"
                              Padding="6" />
                    <TextBlock Text="Обязателен при списании."
                               FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Списать"    Command="{Binding DeductCommand}"  MinWidth="96" Padding="8,6" Margin="0,0,6,0" />
                        <Button Content="Приход"     Command="{Binding RestockCommand}" MinWidth="96" Padding="8,6" Margin="0,0,6,0" />
                        <Button Content="Обновить"   Command="{Binding RefreshCommand}" MinWidth="96" Padding="8,6" />
                    </StackPanel>
                    <Button Content="Экспорт в Excel" Command="{Binding ExportToExcelCommand}"
                            HorizontalAlignment="Stretch" Padding="8,6" Margin="0,8,0,0" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               Margin="0,12,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#047857"
                               Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="Последние движения" FontWeight="SemiBold" Margin="0,16,0,6" />

        <!-- Bug #5. Фильтры журнала движений: дата с/по, категория позиции, инициатор. -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="С:" VerticalAlignment="Center" />
            <DatePicker Grid.Column="2" SelectedDate="{Binding FilterFrom, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="4" Text="По:" VerticalAlignment="Center" />
            <DatePicker Grid.Column="6" SelectedDate="{Binding FilterTo, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="8" Text="Категория:" VerticalAlignment="Center" />
            <ComboBox Grid.Column="10"
                      ItemsSource="{Binding CategoryFilterOptions}"
                      SelectedItem="{Binding FilterCategory, UpdateSourceTrigger=PropertyChanged}"
                      ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" />

            <TextBlock Grid.Column="12" Text="Инициатор:" VerticalAlignment="Center" />
            <ComboBox Grid.Column="14"
                      ItemsSource="{Binding InitiatorOptions}"
                      DisplayMemberPath="FullName"
                      SelectedItem="{Binding FilterInitiator, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="16" Content="Сбросить"
                    Command="{Binding ClearFiltersCommand}" Padding="8,4" />
        </Grid>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding RecentTransactions}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  MaxHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding TransactionDate, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="140" />
                <DataGridTextColumn Header="Тип операции"
                                    Binding="{Binding QuantityChanged, Converter={StaticResource InventoryDeltaSignConverter}, ConverterParameter=Label}"
                                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground"
                                    Value="{Binding QuantityChanged, Converter={StaticResource InventoryDeltaSignConverter}, ConverterParameter=Foreground}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Позиция"
                                    Binding="{Binding InventoryItem.Name, FallbackValue='—'}"
                                    Width="*" />
                <DataGridTextColumn Header="Δ"
                                    Binding="{Binding QuantityChanged}"
                                    Width="60" />
                <DataGridTextColumn Header="Документ"
                                    Binding="{Binding Document.RegistrationNumber, FallbackValue='—'}"
                                    Width="140" />
                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Document.Title, FallbackValue='—'}"
                                    Width="*" />
                <DataGridTextColumn Header="Инициатор"
                                    Binding="{Binding Initiator.FullName, FallbackValue='—'}"
                                    Width="180" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
